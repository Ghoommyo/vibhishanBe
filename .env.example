# Pooled Postgres URL (Neon -pooler host / Supabase transaction pooler in production)
DATABASE_URL=postgresql+psycopg://localhost:5432/vibishan
# Used by pytest only
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/vibishan_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=30
CORS_ORIGINS=http://localhost:8081
ENABLE_DEV_ENDPOINTS=true
